PORT=5000

# Supabase project URL
SUPABASE_URL=your_supabase_project_url

# RECOMMENDED: the service_role key (Project Settings > API). Keep it secret, backend only.
# With it, run database/migrations/002_enable_rls.sql so the public anon key cannot read your tables.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# Only used if the service-role key above is empty (not recommended):
SUPABASE_ANON_KEY=

# REQUIRED: long random string (e.g. run: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=replace_with_a_long_random_secret

# Frontend origin(s) allowed to call this API, comma separated
CORS_ORIGIN=http://localhost:5173

# Optional: Supabase Storage bucket used for resumes/logos/avatars (created automatically)
STORAGE_BUCKET=skillbridge-files
